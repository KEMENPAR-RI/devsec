# Queue worker for the monitoring security (systemd).
#
# Every automatic website check and judol crawl is dispatched as a queued job, so
# without this running the jobs table just fills up and the automatic monitoring
# silently never happens - while "Cek Judol" and "Cek URL Tertentu" keep working,
# because those run inside the web request. See App\Support\QueueHealth.
#
# Install:
#   sudo cp deploy/security-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now security-worker
#   sudo systemctl status security-worker
#
# Adjust User, Group and the two paths below to match the server. WorkingDirectory
# must be the directory that actually holds artisan - systemd fails the unit with
# "status=200/CHDIR" before PHP ever runs if that path does not exist.

[Unit]
Description=Security queue worker
After=network.target mysql.service

# Give up after 10 failures inside 5 minutes instead of restarting forever. A
# worker that dies this fast is failing on something a restart cannot fix (a
# misconfigured .env, an unreachable database), and Restart=always alone would
# retry that silently until someone happened to read the journal. Once tripped,
# the unit stays down until `systemctl reset-failed security-worker` - which is
# the point: the failure becomes visible in `systemctl status`.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/deadsec.apiprs.my.id
Restart=always
RestartSec=5

# --max-time recycles the process hourly so a long-lived worker cannot accumulate
# leaked memory, and --tries=1 keeps a failed crawl from being retried into a
# storm; a scan that fails is simply picked up again on the next schedule tick.
#
# --timeout must stay above the longest job's own $timeout (ScanWebsiteForJudolJob
# is 300s) and below DB_QUEUE_RETRY_AFTER in .env (320s), or a slow crawl gets
# released and run a second time while the first is still going.
ExecStart=cd /www/wwwroot/deadsec.apiprs.my.id && php artisan queue:work --queue=default --sleep=3 --tries=1 --timeout=300 --max-time=3600

# Let a running job finish instead of killing it mid-crawl on restart.
KillSignal=SIGTERM
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target
