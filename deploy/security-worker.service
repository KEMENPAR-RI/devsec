# Queue worker for the monitoring security (systemd).
#
# Every automatic website check and judol crawl is dispatched as a queued job, so
# without this running the jobs table just fills up and the automatic monitoring
# silently never happens - while "Cek Judol" and "Cek URL Tertentu" keep working,
# because those run inside the web request. See App\Support\QueueHealth.
#
# Install:
#   sudo cp deploy/security-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now security-worker
#   sudo systemctl status security-worker
#
# Adjust User, Group and the two paths below to match the server. WorkingDirectory
# must be the directory that actually holds artisan - systemd fails the unit with
# "status=200/CHDIR" before PHP ever runs if that path does not exist.

[Unit]
Description=Security queue worker
After=network.target mysql.service

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=www
Group=www

WorkingDirectory=/www/wwwroot/deadsec.apiprs.my.id

Restart=always
RestartSec=5

ExecStart=/usr/bin/php artisan queue:work \
    --queue=default \
    --sleep=3 \
    --tries=1 \
    --timeout=300 \
    --max-time=3600

KillSignal=SIGTERM
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target
