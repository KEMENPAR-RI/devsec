APP_NAME="Security App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=180
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=320
MONITORING_QUEUE_CHECKS_HIGH=checks-high
MONITORING_QUEUE_CHECKS=checks
MONITORING_QUEUE_SCANS=scans
MONITORING_OFFLINE_RECHECK_MINUTES=10
MONITORING_ALLOWED_PRIVATE_CIDRS=10.10.100.0/24,192.168.55.0/24,172.17.100.0/24
JUDOL_MAX_QUEUE=20
JUDOL_MAX_DISPATCH_PER_TICK=5
JUDOL_AI_TIMEOUT=30
JUDOL_AI_MAX_RETRIES=1
JUDOL_AI_MAX_RETRY_DELAY=10
JUDOL_AI_BUDGET_SECONDS=120

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Saklar utama reCAPTCHA, sengaja hanya di sini dan tidak di menu Pengaturan:
# kalau reCAPTCHA salah konfigurasi, halaman login ikut terkunci - dan menu
# Pengaturan ada di balik login itu. RECAPTCHA_ENABLED=false adalah jalan masuk
# kembali tanpa perlu akses database. Site key & secret diatur dari Pengaturan.
RECAPTCHA_ENABLED=true

# Docker (compose.yaml). Production also needs APP_ENV=production, APP_DEBUG=false,
# LOG_LEVEL=error and a non-root DB_USERNAME with DB_PASSWORD set.
# DB_HOST/DB_PORT are overridden to db:3306 inside the containers.
# Recommended in Docker: LOG_STACK=stderr (logs via `docker compose logs`).
APP_BIND=127.0.0.1
APP_PORT=8080
RUN_MIGRATIONS=false
DB_INNODB_BUFFER_POOL_SIZE=128M
DB_MAX_CONNECTIONS=40
PHP_FPM_PM_MAX_CHILDREN=5
# Fixed subnet of the web-facing network; nginx trusts X-Real-IP only from its gateway
DOCKER_FRONTEND_SUBNET=172.28.0.0/24
DOCKER_FRONTEND_GATEWAY=172.28.0.1
IMAGE_NAME=security-app
IMAGE_TAG=latest
