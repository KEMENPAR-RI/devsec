APP_NAME="Security App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=180
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=320
MONITORING_QUEUE_CHECKS_HIGH=checks-high
MONITORING_QUEUE_CHECKS=checks
MONITORING_QUEUE_SCANS=scans
JUDOL_MAX_QUEUE=20
JUDOL_MAX_DISPATCH_PER_TICK=5
JUDOL_AI_TIMEOUT=30
JUDOL_AI_MAX_RETRIES=1
JUDOL_AI_MAX_RETRY_DELAY=10
JUDOL_AI_BUDGET_SECONDS=120

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Saklar utama reCAPTCHA, sengaja hanya di sini dan tidak di menu Pengaturan:
# kalau reCAPTCHA salah konfigurasi, halaman login ikut terkunci - dan menu
# Pengaturan ada di balik login itu. RECAPTCHA_ENABLED=false adalah jalan masuk
# kembali tanpa perlu akses database. Site key & secret diatur dari Pengaturan.
RECAPTCHA_ENABLED=true
